{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": [
            "python311Full",
            "pip"
          ]
        },
        "install": {
          "cmds": [
            "pip install -r requirements.txt"
          ]
        },
        "start": {
          "cmd": "uvicorn broker_server_fastapi:app --host 0.0.0.0 --port $PORT"
        }
      }
    }
  },
  "env": {
    "ALLOWLIST": "",
    "DEFAULT_PLAN": "FREE",
    "DEFAULT_EXPIRE": "2099-12-31",
    "TTL_SECONDS": "1800"
  }
}