{
  "id": "tpl_txt_pipe_detail",
  "name": "TXT明細帳-直線分隔",
  "file_type": "txt",
  "mode": "print_ledger_txt",
  "encoding": "cp950",
  "control_regex": "~[A-Za-z]+[0-9A-Za-z]*;",
  "account_marker_regex": "(?!)",
  "detail_line_regex": "^\\s*(?P<date>\\d{2,4}[/-]\\d{1,2}[/-]\\d{1,2})\\s*\\|\\s*(?P<vno>[^|]+)\\s*\\|\\s*(?P<account_code>[^|]*)\\s*\\|\\s*(?P<account_name>[^|]*)\\s*\\|\\s*(?P<memo>[^|]*)\\s*\\|\\s*(?P<debit>[-(),\\d.，,]*)\\s*\\|\\s*(?P<credit>[-(),\\d.，,]*)\\s*$",
  "voucher_summary_mode": "none",
  "skip_keywords": [
    "上月結轉",
    "本月結轉",
    "總計",
    "合計"
  ],
  "description": "2026-06-08 功能：預設解析以 | 分隔欄位的 TXT 明細帳。",
  "updated_at": "2026-06-08"
}